{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "outDir": "../.render-check",
    "rootDir": "..",
    "baseUrl": "..",
    "paths": { "@/*": ["./*"] },
    "esModuleInterop": true
  },
  "include": ["render-check.ts", "layer-preview.ts", "dump-art.ts", "../lib/studio/**/*.ts", "../content/**/*.ts"]
}
